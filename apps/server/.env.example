# 复制成同目录下的 .env 再填（已被 Git 忽略）。容器部署不放这个文件，全用同名的环境变量。
# 时长写成数字加单位（按 ms 库的写法），如 30d、24h、1.5h、30s、500ms；光写数字是毫秒。

# 必填。PostgreSQL 连接串；服务启动时自动执行迁移，这个账号要有建表、改表的权限。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eh_pwa

# 必填，至少 32 字节。登录令牌与图片地址的签名密钥都由它派生，换掉等于让所有人重新登录、所有图片地址失效。
# 生成：openssl rand -hex 32
SECRET_KEY=

# 是否开放注册，默认 false。要建第一个账号就临时改成 true，注册完改回来重启。
# ALLOW_REGISTRATION=false

# 登录令牌有效期，默认 30d。
# TOKEN_TTL=30d

# 签名图片地址的有效期，默认 24h。
# ATTACHMENT_TTL=24h

# 出网请求（e 站、图床、标签译名数据源）的超时，默认 30s；等到响应头之后，按多久没收到数据算。
# EH_REQUEST_TIMEOUT=30s

# 出网请求（e 站、图床、标签译名数据源）伪装的 User-Agent，默认是一个桌面 Chrome 的。
# EH_USER_AGENT=Mozilla/5.0 ...

# 日志级别：fatal / error / warn / info / debug / trace / silent，默认 info。debug 会记下每一个发往 e 站的请求。
# LOG_LEVEL=info

# 监听端口，默认 8000。
# PORT=8000
